  "captions": [
    {
      "start": 0.12,
      "end": 2.225354,
      "text": "Wait, where do these steps go"
    },
    {
      "start": 2.225354,
      "end": 4.330708,
      "text": "when they disappear into the floor?"
    },
    {
      "start": 5.12,
      "end": 7.565768,
      "text": "They turn underneath and ride back"
    },
    {
      "start": 7.565768,
      "end": 10.011536,
      "text": "to the bottom. Same steps, one"
    },
    {
      "start": 10.011536,
      "end": 10.826792,
      "text": "big loop."
    },
    {
      "start": 12.12,
      "end": 15.7,
      "text": "So what's pulling them?"
    },
    {
      "start": 16.12,
      "end": 18.388445,
      "text": "An electric motor turns toothed wheels"
    },
    {
      "start": 18.388445,
      "end": 20.656891,
      "text": "that pull a chain along each"
    },
    {
      "start": 20.656891,
      "end": 22.169188,
      "text": "side of the steps."
    },
    {
      "start": 23.12,
      "end": 26.12,
      "text": "Front and back rollers follow separate"
    },
    {
      "start": 26.12,
      "end": 29.12,
      "text": "tracks, keeping the surface you stand"
    },
    {
      "start": 29.12,
      "end": 32.12,
      "text": "on level as the step climbs."
    },
    {
      "start": 33.12,
      "end": 35.552012,
      "text": "Near the top, the tracks bring"
    },
    {
      "start": 35.552012,
      "end": 37.984024,
      "text": "neighboring steps to the same height,"
    },
    {
      "start": 37.984024,
      "end": 40.416036,
      "text": "forming a flat surface before the"
    },
    {
      "start": 40.416036,
      "end": 41.632042,
      "text": "steps turn underneath."
    },
    {
      "start": 43.12,
      "end": 44.583577,
      "text": "So the step I just rode"
    },
    {
      "start": 44.583577,
      "end": 46.047154,
      "text": "comes back around for the next"
    },
    {
      "start": 46.047154,
      "end": 46.291083,
      "text": "person?"
    },
    {
      "start": 46.451083,
      "end": 48.331083,
      "text": "Exactly."
    }
  ],
