  "captions": [
    {
      "start": 0.08,
      "end": 0.579292,
      "text": "Who actually"
    },
    {
      "start": 0.579292,
      "end": 1.846313,
      "text": "discovered fire?"
    },
    {
      "start": 2.933333,
      "end": 3.579895,
      "text": "We don't know."
    },
    {
      "start": 4.019895,
      "end": 5.239896,
      "text": "Natural fires existed"
    },
    {
      "start": 5.239896,
      "end": 6.689063,
      "text": "long before people."
    },
    {
      "start": 6.8799996666666665,
      "end": 7.516874666666666,
      "text": "Like when lightning"
    },
    {
      "start": 7.516874666666666,
      "end": 8.596708666666666,
      "text": "hits a tree?"
    },
    {
      "start": 8.799999666666666,
      "end": 9.249999666666668,
      "text": "Yes."
    },
    {
      "start": 10.556187666666666,
      "end": 12.176187666666667,
      "text": "Lightning's heat can set"
    },
    {
      "start": 12.176187666666667,
      "end": 13.373353666666667,
      "text": "dry wood alight."
    },
    {
      "start": 13.746666666666668,
      "end": 14.306666666666668,
      "text": "Our ancestors"
    },
    {
      "start": 14.306666666666668,
      "end": 14.986666666666666,
      "text": "could keep"
    },
    {
      "start": 14.986666666666666,
      "end": 15.686666666666667,
      "text": "embers glowing"
    },
    {
      "start": 15.686666666666667,
      "end": 17.226666666666667,
      "text": "by feeding them wood."
    },
    {
      "start": 17.517312666666665,
      "end": 18.517312666666665,
      "text": "Making fire themselves"
    },
    {
      "start": 18.517312666666665,
      "end": 19.137312666666666,
      "text": "was a"
    },
    {
      "start": 19.137312666666666,
      "end": 20.010354666666668,
      "text": "different skill."
    },
    {
      "start": 20.346666666666668,
      "end": 21.89387466666667,
      "text": "So finding fire wasn't"
    },
    {
      "start": 21.89387466666667,
      "end": 23.140270666666666,
      "text": "the same as making it."
    },
    {
      "start": 24.266666666666666,
      "end": 25.366666666666667,
      "text": "Right."
    }
  ],
