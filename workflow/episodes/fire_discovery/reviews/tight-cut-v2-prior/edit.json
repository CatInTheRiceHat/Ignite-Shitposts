  "captions": [
    {
      "start": 0.12,
      "end": 1.84,
      "text": "Who actually discovered fire?"
    },
    {
      "start": 3.8,
      "end": 4.48,
      "text": "We don't know."
    },
    {
      "start": 4.94,
      "end": 6.96,
      "text": "Natural fires existed long before"
    },
    {
      "start": 6.96,
      "end": 7.5,
      "text": "people."
    },
    {
      "start": 9.12,
      "end": 10.54,
      "text": "Like when lightning hits a"
    },
    {
      "start": 10.54,
      "end": 10.88,
      "text": "tree?"
    },
    {
      "start": 11.4,
      "end": 14.4,
      "text": "Yes, lightning's heat can set"
    },
    {
      "start": 14.4,
      "end": 15.42,
      "text": "dry wood alight."
    },
    {
      "start": 18.2,
      "end": 19.86,
      "text": "Our ancestors could keep embers"
    },
    {
      "start": 19.86,
      "end": 21.66,
      "text": "glowing by feeding them wood."
    },
    {
      "start": 22.66,
      "end": 24.28,
      "text": "Making fire themselves was a"
    },
    {
      "start": 24.28,
      "end": 24.94,
      "text": "different skill."
    },
    {
      "start": 27.12,
      "end": 29.02,
      "text": "So finding fire wasn't the"
    },
    {
      "start": 29.02,
      "end": 30.1,
      "text": "same as making it."
    },
    {
      "start": 31.0,
      "end": 31.8,
      "text": "Right."
    }
  ],
