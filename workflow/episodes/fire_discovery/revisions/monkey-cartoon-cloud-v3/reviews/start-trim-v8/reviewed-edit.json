  "captions": [
    {
      "start": 0.08,
      "end": 1.846313,
      "text": "Who actually discovered fire?"
    },
    {
      "start": 2.933333,
      "end": 3.579895,
      "text": "We don't know."
    },
    {
      "start": 4.019895,
      "end": 5.239896,
      "text": "Natural fires existed"
    },
    {
      "start": 5.239896,
      "end": 6.689063,
      "text": "long before people."
    },
    {
      "start": 7.013333,
      "end": 8.730042,
      "text": "Like when lightning hits a tree?"
    },
    {
      "start": 8.933333,
      "end": 9.383333,
      "text": "Yes."
    },
    {
      "start": 10.689521,
      "end": 12.309521,
      "text": "Lightning's heat can set"
    },
    {
      "start": 12.309521,
      "end": 13.506687,
      "text": "dry wood alight."
    },
    {
      "start": 13.88,
      "end": 15.12,
      "text": "Our ancestors could keep"
    },
    {
      "start": 15.12,
      "end": 15.82,
      "text": "embers glowing"
    },
    {
      "start": 15.82,
      "end": 17.36,
      "text": "by feeding them wood."
    },
    {
      "start": 17.650646,
      "end": 18.650646,
      "text": "Making fire themselves"
    },
    {
      "start": 18.650646,
      "end": 20.143688,
      "text": "was a different skill."
    },
    {
      "start": 20.48,
      "end": 22.027208,
      "text": "So finding fire wasn't"
    },
    {
      "start": 22.027208,
      "end": 23.273604,
      "text": "the same as making it."
    },
    {
      "start": 24.4,
      "end": 25.5,
      "text": "Right."
    }
  ],
