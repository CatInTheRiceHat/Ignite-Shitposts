{
  "name": "ignite-episodes",
  "version": "1.0.0",
  "description": "Shared dependencies for episode-local Ignite Remotion projects",
  "type": "module",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^18.18.0 || ^20.9.0 || >=21.1.0"
  },
  "private": true,
  "dependencies": {
    "@remotion/bundler": "4.0.542",
    "@remotion/cli": "4.0.542",
    "@remotion/renderer": "4.0.542",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.542",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.542",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "eslint": "9.39.5",
    "prettier": "3.8.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  },
  "scripts": {
    "zipper:dev": "npm run dev --workspace=@ignite/zipper-demo --",
    "zipper:render": "npm run render --workspace=@ignite/zipper-demo --",
    "zipper:still": "npm run still --workspace=@ignite/zipper-demo --",
    "zipper:setup-assets": "npm run setup-assets --workspace=@ignite/zipper-demo",
    "sol:check": "npm run check --workspace=@ignite/sol-lantern",
    "sol:render": "npm run render --workspace=@ignite/sol-lantern",
    "test": "npm test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "allowScripts": {
    "esbuild": false
  },
  "workspaces": [
    "zipper_demo/remotion",
    "sol_kling_test/remotion"
  ]
}
