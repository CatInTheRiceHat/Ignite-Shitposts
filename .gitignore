# Per-frame lettering passes (about 600 MB of PNGs for one ad). Rebuilt exactly by
# skeleton/render_clip.py with MODE=ovlseq, so they stay local like renders/ and clips/.
workflow/episodes/all_due_this_week/overlays/*/seq/
workflow/episodes/all_due_this_week/overlays/*/seq-v1/
