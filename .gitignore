.DS_Store
__pycache__/
*.py[cod]
.venv/
venv/
.cache/
.env
.env.*
!.env.example
*.local.json
credentials*.json
*service-account*.json
workflow/assets/music/**
workflow/episodes/**/clips/*.mp4
workflow/episodes/**/audio/*.mp3
workflow/episodes/**/audio/*.wav
workflow/episodes/**/audio/*.m4a
workflow/episodes/**/audio/*.aiff
workflow/episodes/**/audio/generated/
workflow/episodes/**/renders/
workflow/episodes/**/keyframes/*.png
workflow/episodes/**/keyframes/*.jpg
workflow/episodes/**/keyframes/*.webp
workflow/episodes/**/keyframes/blocking/*.png
workflow/vendor/**/out/**/*.mp4
workflow/vendor/**/out/**/*.png
workflow/vendor/**/out/**/*.jpg
workflow/episodes/**/jobs/useapi/
workflow/episodes/**/keyframes/blocking/useapi/
_to-delete/

# Completed delivery copies stay local (the folder moved here from workflow/completed/ on 2026-11-26,
# where workflow/.gitignore already kept its MP4s out of git).
/completed/*.mp4

# Exports stay private (Elaine, 2026-11-27): no episode video or audio goes to GitHub, wherever
# it sits in the episode folder (skeleton renders, painted clips, comps, narration takes, edits).
workflow/episodes/**/*.mp4
workflow/episodes/**/*.mov
workflow/episodes/**/*.webm
workflow/episodes/**/*.wav
workflow/episodes/**/*.mp3
workflow/episodes/**/*.m4a
workflow/episodes/**/*.aiff

# Per-frame lettering passes (600 MB to 1 GB of PNGs per episode). Rebuilt exactly by
# skeleton/render_clip.py with MODE=ovlseq, so they stay local like renders/ and clips/.
# Covers every episode and every variant folder: seq/, seq-v1/, seq_banner/, seq_moat/ ...
workflow/episodes/**/overlays/*/seq*/

# Shower-curtain episode: first-try arrow renders (175 MB of PNG frames, superseded by overlays/arrows2-*.json) and render logs
workflow/episodes/shower_curtain/overlays/arrows-*/
workflow/episodes/**/skeleton/logs/
